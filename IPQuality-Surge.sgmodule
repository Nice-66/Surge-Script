[Panel]
ipquality-surge = script-name=ipquality-surge, title="节点 IP 质量检测", content="请刷新面板", update-interval=600

[Script]
ipquality-surge = type=generic, timeout=30, script-path=https://raw.githubusercontent.com/Nice-66/Surge-Script/master/IPQuality-Surge.js